# Defaults need no changes. All account credentials are entered in the website.
PORT=8088
BIND_ADDRESS=0.0.0.0
MAX_UPLOAD_MB=512
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Open http://YOUR-SERVER-IP:8088 from another device on your local network.
# Use BIND_ADDRESS=127.0.0.1 if you only want access from the Docker host.
# Set your public HTTPS URL in Connections when connecting accounts on a server.
# For cloudflared running directly on this host, follow CLOUDFLARE.md.
# Its localhost-only setup uses BIND_ADDRESS=127.0.0.1,
# FORWARDED_ALLOW_IPS=*, and MAX_UPLOAD_MB=90 for Cloudflare Free.
